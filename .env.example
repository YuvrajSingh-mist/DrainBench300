# Copy this file to .env and fill in your own keys - .env is gitignored, so it's safe to put
# real secrets there. Loaded automatically by dailybench_runner.py / dailybench_tasks.py (no
# `export`, no --env-file needed) via python-dotenv.

# Required only for the ask_user custom tool (Hard/ASK USER tasks - see
# docs/advanced-features.md's Custom tools section). Not needed for Easy/Medium/DETERMINISTIC
# tasks, or if you're not running the Hard battery at all.
OPENAI_API_KEY=

# Required only if pointing --llm-upstream-base at OpenRouter (or another authenticated
# OpenAI-compatible host) instead of a local llama-server. Not needed for mini2/local inference,
# which doesn't check auth. See docs/advanced-features.md for the OpenRouter setup.
OPENROUTER_API_KEY=

# Required only for scripts/export_*.py's optional Hugging Face push (uv sync --extra hf).
# Not needed for local dataset export/parsing or for running benchmarks.
HF_TOKEN=
